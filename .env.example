# Copy to backend/.env and fill in.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
# Main model for extraction. Swap to compare models in evals.
LLM_MODEL=claude-sonnet-5-5

# --- Database ---
DATABASE_URL=postgresql+psycopg://quote:quote@localhost:5432/quote_agent

# --- Embeddings (local, free, multilingual — works well for Hebrew) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Business settings ---
VAT_RATE=0.18
CURRENCY=ILS
